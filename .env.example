# Copy to .env and fill in what you have. Everything is optional:
# with no keys at all, Artisan Forge runs fully offline using procedural art.

# ---- OpenAI (cover + interior art) ----
OPENAI_API_KEY=
# gpt-image-1.5 | gpt-image-1 | gpt-image-1-mini | gpt-image-2
AF_IMAGE_MODEL=gpt-image-1.5
# low | medium | high
AF_IMAGE_QUALITY=high
# Chat model for bundle content. Leave empty to use the built-in fallback chain.
AF_TEXT_MODEL=

# ---- Cost control ----
# Used by the "lean" cost mode (Crochet Studio) to keep a run cheap.
AF_TEXT_MODEL_CHEAP=gpt-4o-mini
AF_IMAGE_MODEL_CHEAP=gpt-image-1-mini

# Force procedural (no-API) art even when a key is present: 1 / true
AF_OFFLINE=0

# ---- Etsy (draft listings) ----
# From etsy.com/developers -> Your Apps. Keep the shared secret out of git.
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
# Must match the callback registered on Etsy exactly, e.g. https://your-app.up.railway.app
ETSY_REDIRECT_URI=http://localhost:8501
# Only set if your app needs "keystring:shared_secret" in the x-api-key header
AF_ETSY_API_KEY_HEADER=

# Encrypts stored Etsy OAuth tokens. Any random string; changing it invalidates
# saved tokens. If unset, a key file is generated in AF_DATA_DIR.
AF_SECRET_KEY=

# ---- Canva Connect (optional editable designs) ----
# Needs the asset:write, design:content:write and design:content:read scopes.
# Canva has no text-to-image endpoint, so the flow is: ChatGPT writes the image
# prompt -> OpenAI renders it -> the render is pushed to Canva as an editable
# design -> optionally exported back and placed in the pattern PDF.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_ACCESS_TOKEN=
CANVA_REFRESH_TOKEN=

# ---- Output ----
AF_OUTPUT_DIR=output

# ---- Accounts ----
# Set this after creating your own account to make signups invite-only.
AF_SIGNUP_CODE=
# Monthly build cap for the free plan. 0 = unlimited.
AF_FREE_BUILD_LIMIT=0
# Where the SQLite accounts database lives (use a mounted volume in production).
AF_DATA_DIR=data
