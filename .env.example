# Copy to .env and fill in what you have. Everything is optional:
# with no keys at all, Artisan Forge runs fully offline using procedural art.

# ---- AI gateway ----
# "inworld" (default) reaches Qwen and Gemini through one OpenAI-compatible
# endpoint. Set to "openai" to go back to the gpt-image / ChatGPT wiring.
AF_AI_PROVIDER=inworld

# From portal.inworld.ai -> API Keys. Paste the base64 credential as-is; the
# client tries Bearer auth and falls back to Basic, so either format works.
INWORLD_API_KEY=

# Only needed when AF_AI_PROVIDER=openai
OPENAI_API_KEY=

# Override the base URL for any other OpenAI-compatible gateway.
AF_AI_BASE_URL=

# Leave the model pins empty to use the defaults for the chosen provider.
#
# inworld defaults - two models, one job each, no fallback ladder. Prices are
# per million tokens on the Inworld Router:
#   text + vision  deepinfra/Qwen/Qwen3-VL-30B-A3B-Instruct   $0.15 in / $0.60 out
#   image          google-ai-studio/gemini-2.5-flash-image    $0.30 in / $2.50 out
#
# Qwen3-VL does the writing whether or not photographs are attached, so nothing
# is swapped mid-pipeline. Pinning a text-only model here saves a little per
# token and costs a lot in practice: it cannot read the rendered plates, and
# every model that gets tried and fails is billed anyway.
AF_TEXT_MODEL=
AF_TEXT_MODEL_CHEAP=
AF_VISION_MODEL=
AF_IMAGE_MODEL=
AF_IMAGE_MODEL_CHEAP=

# Only meaningful for the gpt-image models: low | medium | high.
# Gemini has no quality parameter - it is billed per output token.
AF_IMAGE_QUALITY=high

# "chat" asks a multimodal chat model for a picture (Gemini), "images" posts to a
# dedicated image endpoint (OpenAI). Normally left to the provider default.
AF_IMAGE_API=

# ---- Cost control ----
# Artwork is still the bulk of a run, but the numbers changed a lot: a Gemini
# plate is about $0.004 against $0.133 for gpt-image-1.5 at "high". A full
# 12-plate photoshoot now costs about $0.056, so the plate counts are generous.

# Cache generated images by prompt hash so a rebuild with the same brief is
# free. Set to 0 to always pay for fresh art.
AF_IMAGE_CACHE=1
AF_CACHE_DIR=cache

# Force procedural (no-API) art even when a key is present: 1 / true
AF_OFFLINE=0

# ---- Etsy (draft listings) ----
# From etsy.com/developers -> Your Apps. Keep the shared secret out of git.
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
# Must match the callback registered on Etsy exactly, e.g. https://your-app.up.railway.app
ETSY_REDIRECT_URI=http://localhost:8501
# Only set if your app needs "keystring:shared_secret" in the x-api-key header
AF_ETSY_API_KEY_HEADER=

# Encrypts stored Etsy OAuth tokens. Any random string; changing it invalidates
# saved tokens. If unset, a key file is generated in AF_DATA_DIR.
AF_SECRET_KEY=

# ---- Canva Connect (optional editable designs) ----
# Needs the asset:write, design:content:write and design:content:read scopes.
# Canva has no text-to-image endpoint, so the flow is: Qwen writes the image
# prompt -> Gemini renders it -> the render is pushed to Canva as an editable
# design -> optionally exported back and placed in the pattern PDF.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_ACCESS_TOKEN=
CANVA_REFRESH_TOKEN=

# ---- Output ----
AF_OUTPUT_DIR=output

# ---- Accounts ----
# Set this after creating your own account to make signups invite-only.
AF_SIGNUP_CODE=
# Monthly build cap for the free plan. 0 = unlimited.
AF_FREE_BUILD_LIMIT=0
# Where the SQLite accounts database lives (use a mounted volume in production).
AF_DATA_DIR=data
