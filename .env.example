# Copy to .env and fill in what you have. Everything is optional:
# with no keys at all, Artisan Forge runs fully offline using procedural art.

# ---- OpenAI (cover + interior art) ----
OPENAI_API_KEY=
# gpt-image-1.5 | gpt-image-1 | gpt-image-1-mini | gpt-image-2
AF_IMAGE_MODEL=gpt-image-1.5
# low | medium | high
AF_IMAGE_QUALITY=high

# Force procedural (no-API) art even when a key is present: 1 / true
AF_OFFLINE=0

# ---- Canva Connect (optional editable designs) ----
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_ACCESS_TOKEN=
CANVA_REFRESH_TOKEN=

# ---- Output ----
AF_OUTPUT_DIR=output

# ---- Streamlit app ----
# Set this on any public deployment (Railway, etc). Empty = no login required.
AF_APP_PASSWORD=
